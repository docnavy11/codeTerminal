# Removes the password prompt for twelve commands. It grants the service user
# no new ability if that user already has sudo — it removes the *password*.
#
# The password is the whole point. The agent's /pty shell runs as dev with no
# password to offer, so a NOPASSWD rule is the only sudo it can actually use.
# That is why this file is scoped to the narrowest useful set rather than
# leaning on the blanket rule dev already has.
#
# No escalation: the unit runs as dev:dev and its file is root-owned, so
# restarting it starts dev's own code as dev. Exact commands, one unit, no
# wildcards — "systemctl restart *" would be equivalent to root, since it
# could restart any unit on the box.
#
# "status" is deliberately ABSENT. It needs no privilege to run, and under sudo
# it would spawn a pager as root — and a pager runs shell commands (!sh), so
# the line would hand out a root shell. Same reasoning keeps journalctl out.
#
# Install (renders __USER__ for the user running it):
#   sudo deploy/install.sh --sudoers
#
# Remove:
#   sudo rm /etc/sudoers.d/code-terminal

__USER__ ALL=(root) NOPASSWD: /usr/bin/systemctl restart code-terminal, \
                         /usr/bin/systemctl restart code-terminal.service, \
                         /usr/bin/systemctl start code-terminal, \
                         /usr/bin/systemctl start code-terminal.service, \
                         /usr/bin/systemctl stop code-terminal, \
                         /usr/bin/systemctl stop code-terminal.service, \
                         /bin/systemctl restart code-terminal, \
                         /bin/systemctl restart code-terminal.service, \
                         /bin/systemctl start code-terminal, \
                         /bin/systemctl start code-terminal.service, \
                         /bin/systemctl stop code-terminal, \
                         /bin/systemctl stop code-terminal.service
