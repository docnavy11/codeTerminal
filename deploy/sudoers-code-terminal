# Lets the dev user manage the code-terminal service without a password.
#
# Deliberately narrow: exact commands, one unit, no wildcards. A wildcard such
# as "systemctl restart *" would be equivalent to root, since it could restart
# any unit on the box.
#
# "status" is deliberately ABSENT. It needs no privilege to run, and under sudo
# it would spawn a pager as root — and a pager runs shell commands (!sh), so
# the line would hand out a root shell. Same reasoning keeps journalctl out.
#
# Install:
#   sudo install -m 0440 -o root -g root \
#     deploy/sudoers-code-terminal /etc/sudoers.d/code-terminal
#
# Remove:
#   sudo rm /etc/sudoers.d/code-terminal

dev ALL=(root) NOPASSWD: /usr/bin/systemctl restart code-terminal, \
                         /usr/bin/systemctl restart code-terminal.service, \
                         /usr/bin/systemctl start code-terminal, \
                         /usr/bin/systemctl start code-terminal.service, \
                         /usr/bin/systemctl stop code-terminal, \
                         /usr/bin/systemctl stop code-terminal.service, \
                         /bin/systemctl restart code-terminal, \
                         /bin/systemctl restart code-terminal.service, \
                         /bin/systemctl start code-terminal, \
                         /bin/systemctl start code-terminal.service, \
                         /bin/systemctl stop code-terminal, \
                         /bin/systemctl stop code-terminal.service
