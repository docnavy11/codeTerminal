# code terminal — configuration. Every line is optional; the defaults run on
# a laptop out of the box.
#
# No shared secret anywhere. Access is by network position:
#   localhost mode  — bind a loopback address (the default): this machine only.
#   tailnet mode    — bind your tailscale IP: every upgrade must pass Origin,
#                     Sec-Fetch-Site and `tailscale whois` (your own identity).
#   cidr mode       — bind a VPN interface and trust its private subnet.
# The server refuses 0.0.0.0 — /pty is an ungated shell.

# ── Where it listens ─────────────────────────────────────────────────────
CODETERM_HOST=127.0.0.1
CODETERM_PORT=8123

# Tailnet: bind the tailscale IP so your other devices can reach it.
# CODETERM_HOST=100.x.y.z

# VPN without tailscale (WireGuard etc.): bind the tunnel IP and trust the
# tunnel subnet. Every entry MUST be a private range — a public one refuses
# to start, because trusting it is an open shell.
# CODETERM_HOST=10.44.0.1
# CODETERM_TRUSTED_CIDRS=10.44.0.0/24,fd00::/8

# Force localhost mode even where tailscale is installed.
# CODETERM_LOCALHOST=1

# ── Paths (defaults: ./workspace, $HOME, $HOME/projects) ─────────────────
# CODETERM_WORKSPACE=/path/the/agent/works/in
# CODETERM_FILES_ROOT=/what/the/file/browser/may/reach
# CODETERM_PROJECTS_ROOT=/where/your/projects/live

# Extra hostnames you browse to, comma-separated (e.g. an /etc/hosts alias),
# so the Origin check accepts them.
# CODETERM_ORIGINS=devbox

# Extra paths the file browser must never show (colon-separated). The
# credential directories under $HOME are always blocked.
# CODETERM_DENY=/srv/secrets

# ── Runaway protection ────────────────────────────────────────────────────
# A turn is interrupted after this many tool calls; the screenshot tool refuses
# past this many per turn; a session stops at this cost. Defaults 100 / 15 /
# none — ceilings a legitimate turn should not reach, not measured optima.
# CODETERM_MAX_TOOL_CALLS=100
# CODETERM_MAX_SCREENSHOTS=15
# CODETERM_MAX_BUDGET_USD=5

# Allow the "Never ask" permission mode (bypassPermissions). Off by default:
# it lets the agent run Bash and edit files with nobody approving.
# CODETERM_ALLOW_BYPASS=1

# ── Browser sites ─────────────────────────────────────────────────────────
# The browser tools ask once per chat before reading or acting on a site
# that is not on the standing list (browser-allow.json, edited on the manage
# page or by "Always" on the card); eval asks every call. Seed the list, or
# turn the gate off entirely (not recommended).
# CODETERM_BROWSER_ALLOW=github.com,*.atlassian.net:read     # host = read+act, host:read = read only
# CODETERM_BROWSER_GATE=0
# A click or Enter that would submit a form with filled fields shows a card
# first (what goes where, which fields) and waits for you. Independent of the
# site gate. Turn off:
# CODETERM_CONFIRM_SUBMIT=0

# The server browser: a headless Chromium on this machine with its own
# profile, started from the manage page (or at boot with =1). Its logins
# persist in the profile; the live view (/browser.html) lets you log in.
# CODETERM_SERVER_BROWSER=1
# CODETERM_SERVER_BROWSER_PROFILE=/home/dev/projects/codeTerminal/server-browser/profile
# CODETERM_CHROMIUM=/usr/bin/chromium      # auto-detected: PATH, then Playwright's cache
# How it presents itself (measured before: "HeadlessChrome", webdriver=true,
# an 800x600 screen — and sites blocked it). Default: an ordinary Chrome UA,
# no webdriver flag, screen = window. Time zone and language should match
# where you are; a proxy through your own connection gets round blocks on
# datacenter IPs (e.g. a SOCKS server on your laptop over the tailnet).
# CODETERM_SERVER_BROWSER_TZ=Europe/Brussels
# CODETERM_SERVER_BROWSER_LANG=en-US,en;q=0.9,nl;q=0.8
# CODETERM_SERVER_BROWSER_PROXY=socks5://my-laptop:1080
# CODETERM_SERVER_BROWSER_PLAIN=0            # keep the headless tell-tales

# Scheduled prompts live here (manage page → Schedules).
# CODETERM_SCHEDULES=/home/dev/projects/codeTerminal/schedules.json

# Pin the browser extension to one extension id.
# CODETERM_EXT_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# Run without your personal ~/.claude skills and CLAUDE.md.
# CODETERM_ISOLATED=1
