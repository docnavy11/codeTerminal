{
  "manifest_version": 3,
  "name": "code terminal bridge",
  "version": "1.0.0",
  "description": "Lets a code-terminal Claude session read and drive this browser.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "code terminal \u2014 open Claude side panel",
    "default_icon": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "popup.html",
  "icons": {
    "128": "icon128.png"
  }
}