{
  "name": "code-terminal",
  "version": "0.1.0",
  "description": "A web UI, Chrome side panel and mobile page over a live Claude Code session: approval-gated agent, real shell, file browser, page watches.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/docnavy11/codeTerminal.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "sync:vendor": "cp node_modules/@xterm/xterm/lib/xterm.js node_modules/@xterm/xterm/css/xterm.css node_modules/@xterm/addon-fit/lib/addon-fit.js node_modules/@xterm/addon-web-links/lib/addon-web-links.js node_modules/marked/lib/marked.umd.js node_modules/dompurify/dist/purify.min.js extension/vendor/",
    "test": "node --import tsx --test test/*.test.ts",
    "test:chromium": "node --import tsx --test test/*.chromium.ts",
    "check": "npm run typecheck && npm test",
    "test:e2e": "CODETERM_E2E=1 node --import tsx --test test/e2e.test.ts",
    "test:browser": "cd test/browser && python3 -m pytest -q -n 4 --dist loadgroup",
    "test:browser:serial": "cd test/browser && python3 -m pytest -q",
    "test:real": "CODETERM_REAL=1 CODETERM_MAX_BUDGET_USD=3 node --import tsx --test test/real.test.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/yazl": "^3.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "express": "^5.1.0",
    "marked": "^18.0.12",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "ws": "^8.18.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
